# Production Environment Variables
# These are used during Vercel production builds

# API Server URL - Override in Vercel Project Settings
# Set this in Vercel Dashboard: Settings → Environment Variables
NEXT_PUBLIC_API_BASE_URL=https://api.lebolink.com

# Stripe Publishable Key - Override in Vercel Project Settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_real_key

# Google Maps API Key - Override in Vercel Project Settings
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_replace_with_real_key
